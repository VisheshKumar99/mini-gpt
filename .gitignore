# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Node / frontend ---
node_modules
dist
dist-ssr
*.local

# --- Environment / secrets ---
# Never commit real env files. Commit .env.example instead.
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/

# --- Databases (generated at runtime) ---
*.db
*.sqlite
*.sqlite3

# --- ML model artifacts / checkpoints ---
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors

# --- Editor directories and files ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Large / generated datasets (regenerate via data/download_data.py) ---
data/*mb.txt
